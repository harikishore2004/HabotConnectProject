
# postgres cred (matches docker-compose.yml)
DB_USER=lsa_user
DB_PASSWORD=lsa_password
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lsa_db

# used by pytest during the CI process - a separate DB so tests never touch actual data base
TEST_DATABASE_URL=postgresql+psycopg2://lsa_user:lsa_password@localhost:5433/lsa_db_test


LOG_LEVEL=INFO